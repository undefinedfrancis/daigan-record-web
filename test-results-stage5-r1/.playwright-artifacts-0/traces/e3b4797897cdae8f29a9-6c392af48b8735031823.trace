{"type":"before","callId":"kvkb@65","startTime":27707.344,"class":"Frame","method":"evaluateExpression","params":{"expression":"async names => {\n    const databases = await indexedDB.databases();\n    const name = databases.map(database => {\n      var _database$name;\n      return (_database$name = database.name) !== null && _database$name !== void 0 ? _database$name : '';\n    }).find(value => value.startsWith('daigan-data-'));\n    if (!name) throw new Error('dataset database not found');\n    const db = await new Promise((resolve, reject) => {\n      const request = indexedDB.open(name);\n      request.onsuccess = () => resolve(request.result);\n      request.onerror = () => reject(request.error);\n    });\n    const result = {};\n    for (const store of names) {\n      result[store] = await new Promise((resolve, reject) => {\n        const tx = db.transaction(store, 'readonly');\n        const request = tx.objectStore(store).getAll();\n        request.onsuccess = () => resolve(request.result);\n        request.onerror = () => reject(request.error);\n      });\n    }\n    db.close();\n    return result;\n  }","isFunction":true,"arg":{"value":{"a":[{"s":"owners"},{"s":"game_accounts"},{"s":"account_categories"},{"s":"game_templates"},{"s":"orders"},{"s":"hosting_periods"},{"s":"hosting_sessions"},{"s":"task_definitions"},{"s":"task_progress_events"},{"s":"attachments"},{"s":"attachmentBlobs"},{"s":"receipts"}],"id":1},"handles":[]}}}
