{"type":"before","callId":"qxnt@846","startTime":57124.853,"class":"Page","method":"addInitScript","params":{"source":"(databaseName => {\n    const request = indexedDB.open(databaseName, 20);\n    request.onupgradeneeded = () => {\n      const db = request.result;\n      const create = (name, keyPath, indexes) => {\n        const store = db.createObjectStore(name, {\n          keyPath\n        });\n        for (const [indexName, keyPathOrArray, unique] of indexes) {\n          store.createIndex(indexName, keyPathOrArray, {\n            unique: Boolean(unique)\n          });\n        }\n        return store;\n      };\n      create('owners', 'id', [['number', 'number', true], ['archivedAt', 'archivedAt']]);\n      create('game_accounts', 'id', [['ownerId', 'ownerId'], ['archivedAt', 'archivedAt']]);\n      create('owner_number_sequence', 'id', []);\n      create('game_server_options', 'id', [['gameName', 'gameName'], ['[gameName+sortOrder]', ['gameName', 'sortOrder']]]);\n      create('orders', 'id', [['accountId', 'accountId'], ['type', 'type'], ['cancelledAt', 'cancelledAt']]);\n      create('hosting_periods', 'id', [['orderId', 'orderId'], ['renewalOperationId', 'renewalOperationId']]);\n      create('order_price_changes', 'id', [['operationId', 'operationId', true], ['orderId', 'orderId'], ['periodId', 'periodId']]);\n      create('task_definitions', 'id', [['orderId', 'orderId'], ['periodId', 'periodId']]);\n      create('task_occurrences', 'id', [['taskDefinitionId', 'taskDefinitionId'], ['gameDate', 'gameDate'], ['completionBatchId', 'completionBatchId']]);\n      create('completion_batches', 'id', [['operationId', 'operationId', true]]);\n      create('completion_batch_items', 'id', [['batchId', 'batchId']]);\n      create('attachments', 'id', [['taskDefinitionId', 'taskDefinitionId'], ['occurrenceId', 'occurrenceId']]);\n      create('receipts', 'id', [['operationId', 'operationId', true], ['orderId', 'orderId'], ['periodId', 'periodId']]);\n      create('receipt_corrections', 'id', [['operationId', 'operationId', true], ['receiptId', 'receiptId']]);\n      create('order_creation_operations', 'operationId', []);\n      create('game_templates', 'id', [['gameName', 'gameName']]);\n      create('template_categories', 'id', [['templateId', 'templateId']]);\n      create('template_tasks', 'id', [['templateId', 'templateId'], ['categoryId', 'categoryId']]);\n      create('template_price_presets', 'id', [['templateId', 'templateId']]);\n      create('template_seed_state', 'seedKey', []);\n      create('reminder_settings', 'id', []);\n      create('attachmentBlobs', 'id', []);\n      create('task_color_marks', 'taskId', []);\n      create('dataset_meta', 'id', []);\n      create('order_color_marks', 'orderId', []);\n    };\n    request.onsuccess = () => {\n      const db = request.result;\n      const now = Date.now();\n      const tx = db.transaction(['owners', 'game_accounts', 'game_server_options', 'orders', 'hosting_periods', 'task_definitions', 'task_occurrences', 'receipts', 'order_creation_operations', 'game_templates', 'template_categories', 'template_tasks', 'reminder_settings', 'dataset_meta', 'task_color_marks', 'order_color_marks'], 'readwrite');\n      const put = (store, row) => tx.objectStore(store).put(row);\n      put('owners', {\n        id: 'legacy-owner',\n        number: 1,\n        nickname: '旧版老板',\n        createdAt: now,\n        updatedAt: now,\n        archivedAt: null,\n        archiveBatchId: null\n      });\n      put('game_accounts', {\n        id: 'legacy-account',\n        ownerId: 'legacy-owner',\n        gameName: '旧版游戏',\n        server: '官服',\n        uid: '7001',\n        loginAccount: 'legacy-login',\n        loginMethod: 'VERIFICATION_CODE',\n        password: null,\n        createdAt: now,\n        updatedAt: now,\n        archivedAt: null,\n        archiveBatchId: null,\n        defaultTemplateId: null,\n        loginDevice: null,\n        resourceNotes: null\n      });\n      put('game_server_options', {\n        id: 'legacy-server',\n        gameName: '旧版游戏',\n        server: '官服',\n        sortOrder: 0\n      });\n      // Legacy web count order: order-level target, C:<date> occurrence keys.\n      put('orders', {\n        id: 'legacy-count-order',\n        accountId: 'legacy-account',\n        type: 'HOSTING',\n        title: '旧版打卡单',\n        priceCents: 6000,\n        paymentMode: 'INSTALLMENTS',\n        deadlineDate: null,\n        notes: null,\n        gameZoneId: 'Asia/Shanghai',\n        dailyRefreshMinutes: 240,\n        weeklyRefreshDay: 1,\n        weeklyRefreshMinutes: 300,\n        createdAt: now,\n        updatedAt: now,\n        cancelledAt: null,\n        completedAt: null,\n        sourceTemplateId: null,\n        sourceTemplateName: null,\n        sourceTemplateVersion: null\n      });\n      put('hosting_periods', {\n        id: 'legacy-period',\n        orderId: 'legacy-count-order',\n        periodIndex: 0,\n        startDate: '2026-03-01',\n        endDate: '2026-03-01',\n        priceCents: 6000,\n        gameZoneId: 'Asia/Shanghai',\n        dailyRefreshMinutes: 240,\n        weeklyRefreshDay: 1,\n        weeklyRefreshMinutes: 300,\n        createdAt: now,\n        renewalOperationId: null,\n        serviceDays: null,\n        serviceWeekdays: null,\n        // web-12 did carry a per-period target; this is what makes the order count-based.\n        serviceCount: 3\n      });\n      put('task_definitions', {\n        id: 'legacy-task-a',\n        orderId: 'legacy-count-order',\n        periodId: 'legacy-period',\n        title: '签到',\n        progressType: 'CHECKBOX',\n        startValue: '0',\n        targetValue: '1',\n        currentValue: '0',\n        unit: null,\n        recurrence: 'DAILY',\n        weekdays: null,\n        everyNDays: null,\n        retiredAt: null,\n        createdAt: now,\n        updatedAt: now,\n        monthDay: null,\n        monthDays: null,\n        sortOrder: 0,\n        completionBatchId: null\n      });\n      put('task_definitions', {\n        id: 'legacy-task-b',\n        orderId: 'legacy-count-order',\n        periodId: 'legacy-period',\n        title: '刷本',\n        progressType: 'NUMERIC',\n        startValue: '0',\n        targetValue: '10',\n        currentValue: '4',\n        unit: '次',\n        recurrence: 'DAILY',\n        weekdays: null,\n        everyNDays: null,\n        retiredAt: null,\n        createdAt: now,\n        updatedAt: now,\n        monthDay: null,\n        monthDays: null,\n        sortOrder: 1,\n        completionBatchId: null\n      });\n      // Two rounds on the same legacy game day: both tasks finished in round 1, only the\n      // checkbox in round 2 (partial progress must survive the C: -> N: migration).\n      put('task_occurrences', {\n        id: 'legacy-occ-1a',\n        taskDefinitionId: 'legacy-task-a',\n        occurrenceKey: 'C:2026-03-02',\n        gameDate: '2026-03-02',\n        windowStart: '2026-03-02',\n        windowEnd: '2026-03-02',\n        completedAt: now,\n        recordedAt: now,\n        backfilled: false,\n        completionBatchId: null,\n        value: null,\n        createdAt: now\n      });\n      put('task_occurrences', {\n        id: 'legacy-occ-1b',\n        taskDefinitionId: 'legacy-task-b',\n        occurrenceKey: 'C:2026-03-02',\n        gameDate: '2026-03-02',\n        windowStart: '2026-03-02',\n        windowEnd: '2026-03-02',\n        completedAt: now,\n        recordedAt: now,\n        backfilled: false,\n        completionBatchId: null,\n        value: '10',\n        createdAt: now\n      });\n      put('task_occurrences', {\n        id: 'legacy-occ-2a',\n        taskDefinitionId: 'legacy-task-a',\n        occurrenceKey: 'C:2026-03-03',\n        gameDate: '2026-03-03',\n        windowStart: '2026-03-03',\n        windowEnd: '2026-03-03',\n        completedAt: now,\n        recordedAt: now,\n        backfilled: false,\n        completionBatchId: null,\n        value: null,\n        createdAt: now\n      });\n      put('receipts', {\n        id: 'legacy-receipt',\n        operationId: 'legacy-payment',\n        orderId: 'legacy-count-order',\n        periodId: 'legacy-period',\n        amountCents: 2000,\n        receivedAt: now,\n        channel: 'WECHAT',\n        note: '旧版部分收款',\n        status: 'ACTIVE',\n        replacedByReceiptId: null,\n        createdAt: now\n      });\n      put('game_templates', {\n        id: 'legacy-template',\n        gameName: '旧版游戏',\n        templateVersion: 'v1',\n        gameVersionNotes: null,\n        zoneId: 'Asia/Shanghai',\n        dailyRefreshMinutes: 240,\n        weeklyRefreshDay: 1,\n        weeklyRefreshMinutes: 300,\n        origin: 'USER',\n        builtInKey: null,\n        sortOrder: 0,\n        createdAt: now,\n        updatedAt: now,\n        serviceMode: 'count',\n        serviceCount: 3\n      });\n      put('reminder_settings', {\n        id: '0',\n        shortDeadlineEnabled: false,\n        shortDeadlineMinutes: 0,\n        hostingExpiryEnabled: false,\n        hostingExpiryMinutes: 0,\n        unfinishedTasksEnabled: false,\n        unfinishedTasksMinutes: 0,\n        updatedAt: now\n      });\n      put('dataset_meta', {\n        id: 'dataset',\n        datasetId: databaseName,\n        createdAt: now\n      });\n      // Legacy local-only colour marks: these must be folded into the business columns.\n      put('task_color_marks', {\n        taskId: 'legacy-task-a',\n        color: 'green'\n      });\n      put('order_color_marks', {\n        orderId: 'legacy-count-order',\n        color: 'blue'\n      });\n      tx.oncomplete = () => db.close();\n    };\n\n    // Control database (Dexie v1/v2 shape) pointing at the legacy dataset.\n    const control = indexedDB.open('daigan-control', 20);\n    control.onupgradeneeded = () => {\n      const db = control.result;\n      db.createObjectStore('state', {\n        keyPath: 'key'\n      });\n      const sessions = db.createObjectStore('sessions', {\n        keyPath: 'id'\n      });\n      sessions.createIndex('status', 'status');\n    };\n    control.onsuccess = () => {\n      const db = control.result;\n      const tx = db.transaction('state', 'readwrite');\n      tx.objectStore('state').put({\n        key: 'activeDataset',\n        value: {\n          databaseName,\n          generation: 1,\n          revision: 0,\n          datasetId: databaseName,\n          lastRestoreId: null,\n          createdAt: Date.now()\n        }\n      });\n      tx.oncomplete = () => db.close();\n    };\n  })(\"daigan-data-legacy-install\")"}}
