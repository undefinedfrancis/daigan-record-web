{"type":"before","callId":"hhkt@430","startTime":43937.573,"class":"Frame","method":"evaluateExpression","params":{"expression":"async names => {\n    const databases = await indexedDB.databases();\n    const name = databases.map(database => {\n      var _database$name;\n      return (_database$name = database.name) !== null && _database$name !== void 0 ? _database$name : '';\n    }).find(value => value.startsWith('daigan-data-'));\n    if (!name) throw new Error('dataset database not found');\n    const db = await new Promise((resolve, reject) => {\n      const request = indexedDB.open(name);\n      request.onsuccess = () => resolve(request.result);\n      request.onerror = () => reject(request.error);\n    });\n    const result = {};\n    for (const store of names) {\n      result[store] = await new Promise((resolve, reject) => {\n        const tx = db.transaction(store, 'readonly');\n        const request = tx.objectStore(store).getAll();\n        request.onsuccess = () => resolve(request.result);\n        request.onerror = () => reject(request.error);\n      });\n    }\n    db.close();\n    return result;\n  }","isFunction":true,"arg":{"value":{"a":[{"s":"orders"},{"s":"hosting_sessions"},{"s":"attachments"},{"s":"game_templates"}],"id":1},"handles":[]}}}
