{"version":10,"type":"context-options","origin":"library","browserName":"chromium","playwrightVersion":"1.64.1","options":{"noDefaultViewport":false,"viewport":{"width":1280,"height":900},"screen":{"width":1920,"height":1080},"ignoreHTTPSErrors":false,"javaScriptEnabled":true,"bypassCSP":false,"userAgent":"Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/156.0.8078.4 Safari/537.36","locale":"zh-CN","timezoneId":"Asia/Shanghai","offline":false,"deviceScaleFactor":1,"isMobile":false,"hasTouch":false,"colorScheme":"light","reducedMotion":"no-preference","forcedColors":"none","acceptDownloads":"accept","contrast":"no-preference","baseURL":"http://127.0.0.1:4322","serviceWorkers":"allow","selectorEngines":[],"testIdAttributeName":"data-testid"},"platform":"darwin","wallTime":1792758191198,"monotonicTime":55825.096,"sdkLanguage":"javascript","testIdAttributeName":"data-testid","title":"stage5.spec.ts:446 › 流程E：已安装的 Dexie 2 库在真实浏览器中升级到 3，无需恢复动作"}
